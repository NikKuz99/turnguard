{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TurnGuard",
  "version": "0.6.2",
  "identifier": "com.nikkuz99.turnguard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TurnGuard — VK TURN Tunnel",
        "width": 900,
        "height": 700,
        "minWidth": 700,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; frame-src 'none'; object-src 'none'"
    },
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true,
      "tooltip": "TurnGuard"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "NikKuz99",
    "copyright": "Copyright © 2026 NikKuz99",
    "category": "Utility",
    "shortDescription": "Cross-platform WireGuard + VK TURN client",
    "longDescription": "Cross-platform WireGuard + VK TURN desktop client with SRTP-mimicry wrap, DNS fallback, and auto-captcha.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "externalBin": ["bin/turnguard"]
  }
}
